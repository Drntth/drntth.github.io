---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout lang="en" title="404 | Tóth Dorina Ildikó" noindex>
  <section class="py-16 text-center">
    <p class="font-display text-8xl font-bold">
      <span class="text-gradient">404</span>
    </p>
    <h1 class="mt-4 font-display text-2xl font-semibold">Page not found</h1>
    <p class="mt-2 text-muted">The page does not exist or has moved.</p>
    <h2 class="mt-8 font-display text-2xl font-semibold">
      Az oldal nem található
    </h2>
    <p class="mt-2 text-muted">
      Az oldal nem létezik, vagy áthelyezésre került.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="btn btn-primary">Home</a>
      <a href="/hu/" class="btn btn-ghost">Kezdőlap</a>
    </div>
  </section>
</BaseLayout>
