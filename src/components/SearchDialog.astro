---
import { Icon } from "astro-icon/components";
import { getContent, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = getContent(lang).search;
const sections = ["projects", "technologies", "research", "method"] as const;
const labels = {
  empty: s.empty,
  results: s.results,
  sections: s.sections,
  types: s.types,
};
---

<dialog
  id="search-dialog"
  class="search-dialog"
  aria-label={s.placeholder}
  data-lang={lang}
  data-labels={JSON.stringify(labels)}
>
  <div class="p-4">
    <div class="relative">
      <Icon
        name="lucide:search"
        class="pointer-events-none absolute left-3 top-1/2 size-4 -translate-y-1/2 text-muted"
      />
      <input
        id="search-dialog-input"
        type="search"
        role="combobox"
        aria-expanded="false"
        aria-controls="search-dialog-list"
        aria-autocomplete="list"
        autocomplete="off"
        placeholder={s.placeholder}
        class="search-input"
      />
    </div>
    <div
      class="mt-3 flex flex-wrap gap-2"
      role="group"
      aria-label={s.filterSection}
    >
      <button type="button" class="chip" data-scope="" aria-pressed="true"
        >{s.all}</button
      >
      {
        sections.map((k) => (
          <button
            type="button"
            class="chip"
            data-scope={k}
            aria-pressed="false"
          >
            {s.sections[k]}
          </button>
        ))
      }
    </div>
    <ul
      id="search-dialog-list"
      role="listbox"
      hidden
      class="search-results search-results--static"
    >
    </ul>
    <p class="sr-only" aria-live="polite" data-status></p>
    <p class="mt-3 text-xs text-muted">{s.hint}</p>
  </div>
</dialog>

<script>
  import { mountSearch } from "../lib/search-ui";
  import type { Section } from "../lib/search";

  const dlg = document.getElementById(
    "search-dialog",
  ) as HTMLDialogElement | null;
  if (dlg) {
    const input = dlg.querySelector<HTMLInputElement>("input")!;
    const list = dlg.querySelector<HTMLElement>("[role=listbox]")!;
    const status = dlg.querySelector<HTMLElement>("[data-status]")!;
    const chips = [
      ...dlg.querySelectorAll<HTMLButtonElement>("button[data-scope]"),
    ];
    let scope: Section | null = null;

    const m = mountSearch({
      lang: dlg.dataset.lang!,
      input,
      list,
      status,
      labels: JSON.parse(dlg.dataset.labels!),
      grouped: true,
      getScope: () => scope,
      onNavigate: () => dlg.close(),
    });

    chips.forEach((b) =>
      b.addEventListener("click", () => {
        scope = (b.dataset.scope || null) as Section | null;
        chips.forEach((x) => x.setAttribute("aria-pressed", String(x === b)));
        void m.run();
        input.focus();
      }),
    );

    const open = () => {
      if (!dlg.open) dlg.showModal();
      input.focus();
      input.select();
    };
    document.addEventListener("click", (e) => {
      if ((e.target as HTMLElement).closest("[data-search-open]")) open();
    });
    document.addEventListener("keydown", (e) => {
      if ((e.ctrlKey || e.metaKey) && e.key.toLowerCase() === "k") {
        e.preventDefault();
        if (dlg.open) dlg.close();
        else open();
      }
    });
    dlg.addEventListener("click", (e) => {
      if (e.target === dlg) dlg.close();
    });
  }
</script>
