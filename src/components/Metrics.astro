---
interface Props {
  metrics: { value: string; label: string }[];
}
const { metrics } = Astro.props;
---

<dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
  {
    metrics.map((m) => (
      <div class="flex flex-col-reverse rounded-xl border border-line bg-surface/60 p-3 text-center">
        <dt class="text-xs text-muted">{m.label}</dt>
        <dd class="font-display text-2xl font-bold text-gradient text-center">
          {m.value}
        </dd>
      </div>
    ))
  }
</dl>
