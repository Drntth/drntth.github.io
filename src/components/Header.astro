---
import { Icon } from "astro-icon/components";
import { getContent, localePath, switchPath, type Lang } from "../i18n/utils";
import { navItems, isCurrent, type NavItem } from "../i18n/nav";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const other: Lang = lang === "en" ? "hu" : "en";
const home = localePath(lang, "/");
const items = navItems(lang);
const cur = (i: NavItem) =>
  isCurrent(Astro.url.pathname, i) ? "page" : undefined;
---

<header
  class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur"
>
  <nav
    class="container-page flex items-center justify-between gap-4 py-3"
    aria-label={c.ui.mainNav}
  >
    <a
      href={home}
      class="shrink-0 whitespace-nowrap font-display font-semibold"
    >
      {c.hero.shortName}
    </a>

    <ul class="nav-pill hidden xl:flex">
      {
        items.map((i) => (
          <li>
            <a href={i.href} aria-current={cur(i)} class="nav-link">
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex shrink-0 items-center gap-2">
      <button
        type="button"
        class="icon-btn"
        data-search-open
        aria-label={c.ui.search}
        title="Ctrl K"
      >
        <Icon name="lucide:search" class="size-4" />
      </button>
      <a
        href={switchPath(Astro.url, other)}
        hreflang={other}
        lang={other}
        data-lang-switch
        aria-label={c.ui.language}
        class="icon-btn text-xs font-medium uppercase">{other}</a
      >
      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label={c.ui.theme}
      >
        <Icon name="lucide:moon" class="size-4 dark:hidden" />
        <Icon name="lucide:sun" class="hidden size-4 dark:block" />
      </button>
      <button
        id="menu-toggle"
        type="button"
        class="icon-btn xl:hidden"
        aria-label={c.ui.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" data-open class="size-5" />
        <Icon name="lucide:x" data-close class="hidden size-5" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg/95 xl:hidden">
    <ul class="container-page grid grid-cols-2 gap-2 py-4 sm:grid-cols-3">
      {
        items.map((i) => (
          <li>
            <a href={i.href} aria-current={cur(i)} class="nav-card">
              {i.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.querySelector("[data-open]")?.classList.toggle("hidden", open);
    btn?.querySelector("[data-close]")?.classList.toggle("hidden", !open);
  };
  btn?.addEventListener("click", () =>
    setOpen(btn.getAttribute("aria-expanded") !== "true"),
  );
  menu
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener(
    "keydown",
    (e) => e.key === "Escape" && setOpen(false),
  );

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
    window.dispatchEvent(new Event("themechange"));
  });

  document
    .querySelectorAll<HTMLAnchorElement>("a[data-lang-switch]")
    .forEach((a) =>
      a.addEventListener("click", () => {
        a.hash = location.hash;
      }),
    );
</script>
