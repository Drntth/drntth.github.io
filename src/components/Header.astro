---
import { Icon } from "astro-icon/components";
import { getContent, localePath, switchPath, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const other: Lang = lang === "en" ? "hu" : "en";
const home = localePath(lang, "/");
const path = Astro.url.pathname.replace(/^\/hu(?=\/|$)/, "") || "/";

const links = [
  { href: `${home}#about`, label: c.nav.about },
  { href: `${home}#stack`, label: c.nav.stack },
  { href: `${home}#certificates`, label: c.nav.certificates },
  {
    href: localePath(lang, "/projects"),
    label: c.nav.projects,
    page: "/projects",
  },
  {
    href: localePath(lang, "/technologies"),
    label: c.nav.technologies,
    page: "/technologies",
  },
  {
    href: localePath(lang, "/research"),
    label: c.nav.research,
    page: "/research",
  },
  { href: `${home}#contact`, label: c.nav.contact },
];
const current = (l: { page?: string }) =>
  l.page && path.startsWith(l.page) ? "page" : undefined;
const linkCls =
  "rounded-md px-2.5 py-1.5 text-sm transition-colors hover:text-accent aria-[current=page]:font-medium aria-[current=page]:text-accent-2";
---

<header
  class="sticky top-0 z-40 border-b border-line/60 bg-bg/80 backdrop-blur"
>
  <nav
    class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-6 py-3"
  >
    <a href={home} class="font-display font-semibold">{c.hero.name}</a>

    <ul class="hidden items-center gap-1 lg:flex">
      {
        links.map((l) => (
          <li>
            <a href={l.href} aria-current={current(l)} class={linkCls}>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>

    <div class="flex items-center gap-2">
      <a
        href={c.contact.cv}
        download
        class="btn btn-primary hidden !py-1.5 sm:inline-flex"
      >
        <Icon name="lucide:file-down" class="size-4" />{c.nav.cv}
      </a>
      <a
        href={switchPath(Astro.url, other)}
        hreflang={other}
        lang={other}
        aria-label={c.ui.language}
        class="icon-btn text-xs font-medium uppercase">{other}</a
      >
      <button
        id="theme-toggle"
        type="button"
        class="icon-btn"
        aria-label={c.ui.theme}
      >
        <Icon name="lucide:moon" class="size-4 dark:hidden" />
        <Icon name="lucide:sun" class="hidden size-4 dark:block" />
      </button>
      <button
        id="menu-toggle"
        type="button"
        class="icon-btn lg:!hidden"
        aria-label={c.ui.menu}
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="lucide:menu" data-open class="size-5" />
        <Icon name="lucide:x" data-close class="hidden size-5" />
      </button>
    </div>
  </nav>

  <div id="mobile-menu" class="hidden border-t border-line bg-bg lg:hidden">
    <ul class="mx-auto flex max-w-6xl flex-col gap-1 px-6 py-3">
      {
        links.map((l) => (
          <li>
            <a
              href={l.href}
              aria-current={current(l)}
              class={`${linkCls} block py-2.5 text-base`}
            >
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</header>

<script>
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  const setOpen = (open: boolean) => {
    menu?.classList.toggle("hidden", !open);
    btn?.setAttribute("aria-expanded", String(open));
    btn?.querySelector("[data-open]")?.classList.toggle("hidden", open);
    btn?.querySelector("[data-close]")?.classList.toggle("hidden", !open);
  };
  btn?.addEventListener("click", () =>
    setOpen(btn.getAttribute("aria-expanded") !== "true"),
  );
  menu
    ?.querySelectorAll("a")
    .forEach((a) => a.addEventListener("click", () => setOpen(false)));
  document.addEventListener(
    "keydown",
    (e) => e.key === "Escape" && setOpen(false),
  );

  document.getElementById("theme-toggle")?.addEventListener("click", () => {
    const dark = document.documentElement.classList.toggle("dark");
    localStorage.setItem("theme", dark ? "dark" : "light");
    window.dispatchEvent(new Event("themechange"));
  });
</script>
