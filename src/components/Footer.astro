---
import { Icon } from "astro-icon/components";
import { getContent, localePath, type Lang } from "../i18n/utils";
import { navItems } from "../i18n/nav";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const f = c.footer;
const items = navItems(lang).filter((i) => i.id !== "contact");
const year = new Date().getFullYear();
---

<footer id="site-footer" class="mt-16 scroll-mt-20">
  <div class="footer-rule" aria-hidden="true"></div>
  <div class="container-page py-12">
    <div class="grid gap-10 lg:grid-cols-[1.4fr_1fr_1fr]">
      <div>
        <a
          href={localePath(lang, "/")}
          class="font-display text-xl font-semibold"
        >
          <span class="text-gradient">{c.hero.name}</span>
        </a>
        <p class="mt-1 text-sm text-accent">{c.hero.role}</p>
        <p class="mt-4 text-sm text-muted">{f.text}</p>
      </div>

      <nav aria-label={f.navTitle}>
        <h2 class="footer-title">{f.navTitle}</h2>
        <ul class="grid grid-cols-2 gap-x-6 gap-y-2 text-sm">
          {
            items.map((i) => (
              <li>
                <a href={i.href} class="footer-link">
                  {i.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <h2 class="footer-title">{c.contact.title}</h2>
        <ul class="space-y-2 text-sm">
          <li>
            <a href={`mailto:${c.contact.email}`} class="footer-link">
              <Icon name="lucide:mail" class="size-4" />{c.contact.email}
            </a>
          </li>
          <li>
            <a
              href={c.contact.github}
              class="footer-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="mdi:github" class="size-4" />GitHub
            </a>
          </li>
          <li>
            <a
              href={c.contact.linkedin}
              class="footer-link"
              target="_blank"
              rel="noopener noreferrer"
            >
              <Icon name="mdi:linkedin" class="size-4" />LinkedIn
            </a>
          </li>
        </ul>
        <a href={c.contact.cv} download class="btn btn-primary mt-5">
          <Icon name="lucide:file-down" class="size-4" />{f.cv}
        </a>
      </div>
    </div>

    <div
      class="mt-10 flex flex-wrap items-center justify-between gap-x-6 gap-y-3 border-t border-line pt-6 text-xs text-muted"
    >
      <p>&copy; {year} - {c.hero.name}</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a
          href="https://github.com/Drntth/drntth.github.io"
          class="footer-link"
          target="_blank"
          rel="noopener noreferrer">{f.source}</a
        >
        <span>{f.rights}</span>
      </p>
      <a href="#" class="footer-link" aria-label={c.ui.top}>
        <Icon name="lucide:arrow-up" class="size-4" />{c.ui.top}
      </a>
    </div>
  </div>
</footer>
