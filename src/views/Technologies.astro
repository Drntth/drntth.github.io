---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import KnowledgeGraph from "../components/KnowledgeGraph.astro";
import ResearchFlow from "../components/ResearchFlow.astro";
import TechChip from "../components/TechChip.astro";
import { getContent, localePath, type Lang } from "../i18n/utils";
import { buildGraph } from "../lib/graph";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const L = c.technologiesPage;
const graph = await buildGraph(lang);
const techs = (await getCollection("technologies")).sort(
  (a, b) => a.data.order - b.data.order,
);
const box = "rounded-lg border px-4 py-3 text-center text-sm font-medium";
---

<BaseLayout lang={lang} title={`${L.title} | ${c.hero.name}`}>
  <h1 class="section-title reveal !text-4xl">{L.title}</h1>
  <p class="reveal mb-12 text-justify text-muted">{L.intro}</p>

  <section class="mb-14">
    <h2 class="section-title reveal">{L.modelTitle}</h2>
    <p class="reveal mb-6 text-justify text-muted">{L.modelText}</p>
    <div
      class="card reveal flex flex-col items-stretch gap-3 p-6 md:flex-row md:items-center md:justify-between"
    >
      <div class={`${box} border-accent-2/60`}>{L.modelLabels.language}</div>
      <div class="flex items-center justify-center gap-2 text-xs text-muted">
        <span>{L.modelLabels.implements}</span>
        <Icon name="lucide:arrow-right" class="hidden size-4 md:block" /><Icon
          name="lucide:arrow-down"
          class="size-4 md:hidden"
        />
      </div>
      <div class={`${box} border-accent/60`}>{L.modelLabels.technology}</div>
      <div class="flex items-center justify-center gap-2 text-xs text-muted">
        <span>{L.modelLabels.usedBy}</span>
        <Icon name="lucide:arrow-right" class="hidden size-4 md:block" /><Icon
          name="lucide:arrow-down"
          class="size-4 md:hidden"
        />
      </div>
      <div class={`${box} border-fg/40`}>{L.modelLabels.project}</div>
    </div>
    <p class="reveal mt-3 text-xs text-muted">{L.modelExample}</p>
  </section>

  <section class="mb-14">
    <h2 class="section-title reveal">{L.flowTitle}</h2>
    <p class="reveal mb-6 text-justify text-muted">{L.flowNote}</p>
    <ResearchFlow steps={L.flow} />
  </section>

  <section class="mb-14">
    <h2 class="section-title reveal">{L.graphTitle}</h2>
    <div class="reveal">
      <KnowledgeGraph
        nodes={graph.nodes}
        links={graph.links}
        label={L.graphLabel}
        hint={L.graphHint}
        legend={L.legend}
      />
    </div>
  </section>

  <section>
    <h2 class="section-title reveal">{L.nodesTitle}</h2>
    <div class="grid gap-4 md:grid-cols-2">
      {
        techs.map((t) => {
          const d = t.data[lang];
          const planned = t.data.visibility === "planned";
          return (
            <a
              href={localePath(lang, `/technologies/${t.id}`)}
              class="card reveal block p-5"
            >
              <div class="flex items-start justify-between gap-3">
                <Icon name={t.data.icon} class="size-7 text-accent" />
                <span class:list={["chip", planned && "!border-dashed"]}>
                  {planned ? L.planned : L.published}
                </span>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold">{d.title}</h3>
              <p class="mt-2 text-sm text-muted">{d.summary}</p>
              {t.data.implementations.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {t.data.implementations.map((i) => (
                    <li>
                      <TechChip id={i.language} lang={lang} />
                    </li>
                  ))}
                </ul>
              )}
            </a>
          );
        })
      }
    </div>
  </section>
</BaseLayout>
