---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import KnowledgeGraph from "../components/KnowledgeGraph.astro";
import TechChip from "../components/TechChip.astro";
import PageHeader from "../components/PageHeader.astro";
import FilterBar from "../components/FilterBar.astro";
import { getContent, localePath, type Lang } from "../i18n/utils";
import { techOf } from "../i18n/stack";
import { buildGraph } from "../lib/graph";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const L = c.technologiesPage;
const S = c.search;
const graph = await buildGraph(lang);
const techs = (await getCollection("technologies")).sort(
  (a, b) => a.data.order - b.data.order,
);
const languages = [
  ...new Map(
    techs.flatMap((t) =>
      t.data.implementations.map(
        (i) => [i.language, techOf(i.language, lang).name] as const,
      ),
    ),
  ).entries(),
];
const filterGroups = [
  {
    key: "language",
    label: S.filterLanguage,
    options: languages.map(([id, name]) => ({ id, label: name })),
  },
  {
    key: "status",
    label: S.filterStatus,
    options: [
      { id: "published", label: L.published },
      { id: "planned", label: L.planned },
    ],
  },
];
---

<BaseLayout
  lang={lang}
  title={L.seoTitle}
  description={L.description}
>
  <PageHeader
    lang={lang}
    title={L.title}
    intro={L.intro}
    kind="technologies"
    scope="technologies"
  >
    <FilterBar
      slot="tools"
      lang={lang}
      groups={filterGroups}
      total={techs.length}
    />
  </PageHeader>

  <section class="mb-14">
    <h2 class="section-title reveal">{L.graphTitle}</h2>
    <div class="reveal">
      <KnowledgeGraph
        nodes={graph.nodes}
        links={graph.links}
        label={L.graphLabel}
        hint={L.graphHint}
        legend={L.legend}
      />
    </div>
    <p class="reveal mt-4 text-sm text-muted">
      {L.modelHint}
      <a
        href={`${localePath(lang, "/method")}#knowledge`}
        class="text-accent underline-offset-4 hover:underline"
        >{L.modelLink}</a
      >
    </p>
  </section>

  <section>
    <h2 class="section-title reveal">{L.nodesTitle}</h2>
    <div class="grid gap-4 md:grid-cols-2 xl:grid-cols-3" data-cards>
      {
        techs.map((t) => {
          const d = t.data[lang];
          const planned = t.data.visibility === "planned";
          const href = localePath(lang, `/technologies/${t.id}`);
          return (
            <a
              href={href}
              class:list={[
                "card reveal block p-5",
                planned && "border-dashed",
              ]}
              data-card
              data-url={href}
              data-languages={t.data.implementations
                .map((i) => i.language)
                .join(" ")}
              data-status={planned ? "planned" : "published"}
            >
              <div class="flex items-start justify-between gap-3">
                <Icon name={t.data.icon} class="size-7 text-accent" />
                <span
                  class:list={[
                    "chip",
                    planned && "border-dashed border-accent-2/60 text-accent-2",
                  ]}
                >
                  {planned ? L.planned : L.published}
                </span>
              </div>
              <h3 class="mt-3 font-display text-lg font-semibold">{d.title}</h3>
              <p class="mt-2 text-sm text-muted">{d.summary}</p>
              {t.data.implementations.length > 0 && (
                <ul class="mt-4 flex flex-wrap gap-2">
                  {t.data.implementations.map((i) => (
                    <li>
                      <TechChip id={i.language} lang={lang} />
                    </li>
                  ))}
                </ul>
              )}
            </a>
          );
        })
      }
    </div>
    <p class="mt-4 text-sm text-muted" data-no-results hidden>
      {S.noMatch}
    </p>
  </section>
</BaseLayout>

<script>
  const grid = document.querySelector<HTMLElement>("[data-cards]");
  const bar = document.querySelector<HTMLDetailsElement>("[data-filters]");
  if (grid && bar) {
    const cards = [...grid.querySelectorAll<HTMLElement>("[data-card]")];
    const buttons = [
      ...bar.querySelectorAll<HTMLButtonElement>("button[data-filter-group]"),
    ];
    const reset = bar.querySelector<HTMLElement>("[data-filter-reset]")!;
    const count = bar.querySelector<HTMLElement>("[data-filter-count]")!;
    const status = bar.querySelector<HTMLElement>("[data-filter-status]")!;
    const empty = document.querySelector<HTMLElement>("[data-no-results]")!;
    const labels = JSON.parse(bar.dataset.labels!) as Record<string, string>;
    const total = Number(bar.dataset.total);
    let urls: Set<string> | null = null;

    // Always open on desktop; collapsible panel below md.
    const desktop = matchMedia("(min-width: 768px)");
    const sync = () => {
      if (desktop.matches) bar.open = true;
    };
    sync();
    desktop.addEventListener("change", sync);
    bar.addEventListener("toggle", sync);

    const pressed = (group: string) =>
      buttons
        .filter(
          (b) =>
            b.dataset.filterGroup === group &&
            b.getAttribute("aria-pressed") === "true",
        )
        .map((b) => b.dataset.filterValue!);

    const apply = () => {
      const langs = pressed("language");
      const stats = pressed("status");
      let shown = 0;
      cards.forEach((card) => {
        const ok =
          (!urls || urls.has(card.dataset.url!)) &&
          (!langs.length ||
            langs.some((l) => card.dataset.languages!.split(" ").includes(l))) &&
          (!stats.length || stats.includes(card.dataset.status!));
        card.hidden = !ok;
        if (ok) shown++;
      });
      const active = langs.length + stats.length;
      empty.hidden = shown > 0;
      reset.hidden = active === 0;
      const text = `${labels.showing} ${shown} ${labels.of} ${total} ${labels.unit}${
        active ? ` · ${active} ${labels.active}` : ""
      }`;
      count.textContent = text;
      status.textContent = text;
    };

    buttons.forEach((b) =>
      b.addEventListener("click", () => {
        b.setAttribute(
          "aria-pressed",
          String(b.getAttribute("aria-pressed") !== "true"),
        );
        apply();
      }),
    );
    reset.addEventListener("click", () => {
      buttons.forEach((b) => b.setAttribute("aria-pressed", "false"));
      apply();
    });
    window.addEventListener("search:results", (e) => {
      const d = (e as CustomEvent).detail as {
        scope: string;
        query: string;
        urls: string[];
      };
      if (d.scope !== "technologies") return;
      urls = d.query ? new Set(d.urls) : null;
      apply();
    });
    apply();
  }
</script>
