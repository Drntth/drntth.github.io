---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import { getContent, localePath, loc, type Lang } from "../i18n/utils";
import PageHeader from "../components/PageHeader.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const L = c.researchPage;
const items = (await getCollection("research")).sort(
  (a, b) => a.data.order - b.data.order,
);
const projects = await getCollection("projects");
---

<BaseLayout
  lang={lang}
  title={L.seoTitle}
  description={L.description}
>
  <PageHeader
    lang={lang}
    title={L.title}
    intro={L.intro}
    kind="research"
    scope="research"
  />

  <ul class="reveal mb-10 flex flex-wrap gap-2" aria-label={L.rulesTitle}>
    {
      L.rules.map((r) => (
        <li class="chip">
          <Icon name="lucide:shield-check" class="size-3.5 text-accent-2" />
          {r}
        </li>
      ))
    }
  </ul>

  <div class="grid gap-6 md:grid-cols-2" data-cards>
    {
      items.map((r) => {
        const d = r.data[lang];
        const url = localePath(lang, `/research/${r.id}`);
        const proj = projects.find((p) => r.data.projects.includes(p.id));
        return (
          <article
            data-card
            data-url={url}
            class="card reveal flex flex-col p-6"
          >
            <div class="flex flex-wrap items-center gap-3">
              <Icon name={r.data.icon} class="size-7 text-accent" />
              <span class="chip">{loc(r.data.topic, lang)}</span>
            </div>
            <h2 class="mt-3 font-display text-xl font-semibold">
              <a href={url} class="hover:text-accent">
                {d.title}
              </a>
            </h2>
            <p class="mt-2 text-sm text-muted">{d.summary}</p>
            <p class="mt-4 text-sm">
              <span class="font-medium text-accent">{L.question}:</span>{" "}
              {d.question}
            </p>
            <div class="mt-auto flex flex-wrap items-center gap-3 border-t border-line pt-5 mt-6">
              <a href={url} class="btn btn-primary">
                {L.read}
                <Icon name="lucide:arrow-right" class="size-4" />
              </a>
              {proj && (
                <a
                  class="chip"
                  href={localePath(lang, `/projects/${proj.id}`)}
                >
                  {proj.data.label?.[lang] ?? proj.data[lang].title}
                </a>
              )}
            </div>
          </article>
        );
      })
    }
  </div>
  <p class="mt-4 text-sm text-muted" data-no-results style="display:none">
    {L.noMatch}
  </p>
</BaseLayout>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-cards]");
  if (wrap) {
    const cards = [...wrap.querySelectorAll<HTMLElement>("[data-card]")];
    const empty = document.querySelector<HTMLElement>("[data-no-results]")!;
    window.addEventListener("search:results", (e) => {
      const d = (e as CustomEvent).detail as {
        scope: string;
        query: string;
        urls: string[];
      };
      if (d.scope !== "research") return;
      const urls = d.query ? new Set(d.urls) : null;
      let shown = 0;
      cards.forEach((card) => {
        const ok = !urls || urls.has(card.dataset.url!);
        card.style.display = ok ? "" : "none";
        if (ok) shown++;
      });
      empty.style.display = shown > 0 ? "none" : "";
    });
  }
</script>
