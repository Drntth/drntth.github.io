---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import TechChip from "../components/TechChip.astro";
import { getContent, localePath, type Lang } from "../i18n/utils";
import { techOf } from "../i18n/stack";

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const c = getContent(lang);
const L = c.technologiesPage;
const tech = (await getEntry("technologies", slug))!;
const d = tech.data[lang];
// Short summaries get a suffix to reach a useful meta description length.
const description =
  d.summary.length < 100 ? `${d.summary} ${L.detailDescription}` : d.summary;
const projects = (await getCollection("projects")).filter((p) =>
  p.data.concepts.includes(slug),
);
const research = (await getCollection("research")).filter((r) =>
  r.data.technologies.includes(slug),
);
const steps = d.process
  ? [
      [L.requirement, d.process.requirement],
      [L.question, d.process.question],
      [L.validation, d.process.validation],
      [L.decision, d.process.decision],
    ]
  : [];
const sections = [
  d.body.length > 0 && { id: "overview", title: d.title },
  { id: "implementations", title: L.implementations },
  projects.length > 0 && { id: "projects", title: L.usedBy },
  research.length > 0 && { id: "research", title: L.researchBy },
].filter((x): x is { id: string; title: string } => Boolean(x));

const breadcrumbs = {
  "@context": "https://schema.org",
  "@type": "BreadcrumbList",
  itemListElement: [
    [c.nav.home, "/"],
    [L.title, "/technologies"],
    [d.title, `/technologies/${slug}`],
  ].map(([name, path], i) => ({
    "@type": "ListItem",
    position: i + 1,
    name,
    item: new URL(localePath(lang, path), Astro.site).href,
  })),
};
---

<BaseLayout
  lang={lang}
  title={`${d.title} | ${L.title} | ${c.hero.shortName}`}
  description={description}
  jsonLd={breadcrumbs}
>
  <a href={localePath(lang, "/technologies")} class="btn btn-ghost no-print mb-6">
    <Icon name="lucide:arrow-left" class="size-4" />{L.back}
  </a>

  <header class="card reveal relative mb-8 overflow-hidden">
    <div class="bg-linear-to-br from-accent/20 to-accent-2/20 p-6 md:p-10">
      <Icon
        name={tech.data.icon}
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-8 -right-8 size-56 text-accent opacity-10"
      />
      <div class="relative">
        <h1 class=" font-display text-3xl font-bold md:text-5xl">
          <span class="text-gradient">{d.title}</span>
        </h1>
        <p class="mt-5 text-muted lg:text-lg">{d.summary}</p>
      </div>
    </div>
  </header>

  <div
    class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] xl:grid-cols-[minmax(0,1fr)_22rem]"
  >
    <div class="min-w-0">
      {
        steps.length > 0 && (
          <section class="mb-10 grid gap-4 md:grid-cols-2">
            {steps.map(([k, v], i) => (
              <div class="card reveal p-5">
                <p
                  class:list={[
                    "mb-1 text-sm font-medium",
                    i % 2 ? "text-accent-2" : "text-accent",
                  ]}
                >
                  {k}
                </p>
                <p class="text-sm text-muted">{v}</p>
              </div>
            ))}
          </section>
        )
      }

      {
        d.body.length > 0 && (
          <section id="overview" class="mb-10 scroll-mt-24 space-y-3 text-muted">
            {d.body.map((p) => (
              <p class="reveal">{p}</p>
            ))}
          </section>
        )
      }

      <section id="implementations" class="mb-10 scroll-mt-24">
        <h2 class="section-title reveal text-xl">{L.implementations}</h2>
        {
          tech.data.implementations.length === 0 ? (
            <p class="text-sm text-muted">{L.noImpl}</p>
          ) : (
            <div class="grid gap-4 md:grid-cols-2">
              {tech.data.implementations.map((i) => (
                <article class="card reveal p-5">
                  <TechChip id={i.language} lang={lang} />
                  <p class="mt-3 text-sm text-muted">{i[lang].summary}</p>
                  {i[lang].notes.length > 0 && (
                    <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
                      {i[lang].notes.map((n) => (
                        <li class="justify">{n}</li>
                      ))}
                    </ul>
                  )}
                </article>
              ))}
            </div>
          )
        }
      </section>

      {
        projects.length > 0 && (
          <section id="projects" class="mb-10 scroll-mt-24">
            <h2 class="section-title reveal text-xl">{L.usedBy}</h2>
            <ul class="reveal flex flex-wrap gap-3">
              {projects.map((p) => (
                <li>
                  <a
                    class="btn btn-ghost"
                    href={localePath(lang, `/projects/${p.id}`)}
                  >
                    {p.data[lang].title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      {
        research.length > 0 && (
          <section id="research" class="scroll-mt-24">
            <h2 class="section-title reveal text-xl">{L.researchBy}</h2>
            <ul class="reveal flex flex-wrap gap-3">
              {research.map((r) => (
                <li>
                  <a
                    class="btn btn-ghost"
                    href={localePath(lang, `/research/${r.id}`)}
                  >
                    {r.data[lang].title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      <nav class="card no-print hidden p-5 lg:block" aria-label={L.toc}>
        <h2 class="side-title">{L.toc}</h2>
        <ol class="space-y-2 text-sm">
          {
            sections.map((s) => (
              <li>
                <a href={`#${s.id}`} class="side-link">
                  {s.title}
                </a>
              </li>
            ))
          }
        </ol>
      </nav>
      {
        tech.data.implementations.length > 0 && (
          <section class="card p-5">
            <h2 class="side-title">{L.languagesTitle}</h2>
            <ul class="flex flex-wrap gap-2">
              {tech.data.implementations.map((i) => (
                <li>
                  <TechChip id={i.language} lang={lang} />
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </aside>
  </div>
</BaseLayout>
