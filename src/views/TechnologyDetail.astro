---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import TechChip from "../components/TechChip.astro";
import { getContent, localePath, type Lang } from "../i18n/utils";
import { techOf } from "../i18n/stack";

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const c = getContent(lang);
const L = c.technologiesPage;
const tech = (await getEntry("technologies", slug))!;
const d = tech.data[lang];
const planned = tech.data.visibility === "planned";
const projects = (await getCollection("projects")).filter(
  (p) => p.data.visibility === "public" && p.data.concepts.includes(slug),
);
const research = (await getCollection("research")).filter((r) =>
  r.data.technologies.includes(slug),
);
const steps = d.process
  ? [
      [L.requirement, d.process.requirement],
      [L.question, d.process.question],
      [L.validation, d.process.validation],
      [L.decision, d.process.decision],
    ]
  : [];
---

<BaseLayout
  lang={lang}
  title={`${d.title} | ${L.title} | ${c.hero.name}`}
  description={d.summary}
>
  <a href={localePath(lang, "/technologies")} class="btn btn-ghost mb-8"
    ><Icon name="lucide:arrow-left" class="size-4" />{L.back}</a
  >

  <header class="reveal mb-10">
    <span class:list={["chip", planned && "!border-dashed"]}
      >{planned ? L.planned : L.published}</span
    >
    <h1 class="mt-3 flex items-center gap-3 font-display text-4xl font-bold">
      <Icon name={tech.data.icon} class="size-9 text-accent" /><span
        class="text-gradient">{d.title}</span
      >
    </h1>
    <p class="mt-4 text-justify text-lg text-muted">{d.summary}</p>
  </header>

  {
    steps.length > 0 && (
      <section class="mb-10 grid gap-4 md:grid-cols-2">
        {steps.map(([k, v], i) => (
          <div class="card reveal p-5">
            <p
              class:list={[
                "mb-1 text-sm font-medium",
                i % 2 ? "text-accent-2" : "text-accent",
              ]}
            >
              {k}
            </p>
            <p class="text-sm text-muted">{v}</p>
          </div>
        ))}
      </section>
    )
  }

  {
    d.body.length > 0 && (
      <section class="mb-10 text-justify space-y-3 text-muted">
        {d.body.map((p) => (
          <p class="reveal">{p}</p>
        ))}
      </section>
    )
  }

  {
    d.planned.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title reveal">{L.plannedTitle}</h2>
        <ul class="reveal text-justify space-y-2 text-sm">
          {d.planned.map((p) => (
            <li class="flex gap-2">
              <Icon
                name="lucide:circle-dashed"
                class="mt-0.5 size-4 shrink-0 text-accent-2"
              />
              <span>{p}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  <section class="mb-10">
    <h2 class="section-title reveal">{L.implementations}</h2>
    {
      tech.data.implementations.length === 0 ? (
        <p class="text-sm text-muted">{L.noImpl}</p>
      ) : (
        <div class="grid gap-4 md:grid-cols-2">
          {tech.data.implementations.map((i) => (
            <article class="card reveal p-5">
              <TechChip id={i.language} lang={lang} />
              <p class="mt-3 text-sm text-muted">{i[lang].summary}</p>
              {i[lang].notes.length > 0 && (
                <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-muted">
                  {i[lang].notes.map((n) => (
                    <li>{n}</li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      )
    }
  </section>

  {
    projects.length > 0 && (
      <section class="mb-10">
        <h2 class="section-title reveal">{L.usedBy}</h2>
        <ul class="reveal flex flex-wrap gap-3">
          {projects.map((p) => (
            <li>
              <a
                class="btn btn-ghost"
                href={localePath(lang, `/projects/${p.id}`)}
              >
                {p.data[lang].title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    research.length > 0 && (
      <section>
        <h2 class="section-title reveal">{L.researchBy}</h2>
        <ul class="reveal flex flex-wrap gap-3">
          {research.map((r) => (
            <li>
              <a
                class="btn btn-ghost"
                href={`${localePath(lang, "/research")}#${r.id}`}
              >
                {r.data[lang].title}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</BaseLayout>
