---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import Carousel from "../components/Carousel.astro";
import TechChip from "../components/TechChip.astro";
import { getContent, localePath, loc, type Lang } from "../i18n/utils";
import { groups } from "../i18n/stack";
import avatar from "../assets/avatar.jpg";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const home = localePath(lang, "/");

const projects = (await getCollection("projects"))
  .filter((p) => p.data.visibility === "public")
  .sort((a, b) => a.data.order - b.data.order);
const certs = (await getCollection("certificates")).sort(
  (a, b) => a.data.order - b.data.order,
);
const fmt = new Intl.DateTimeFormat(lang === "hu" ? "hu-HU" : "en-GB", {
  dateStyle: "long",
});
const slide = "min-w-0 shrink-0 grow-0 basis-full p-1";
---

<BaseLayout lang={lang}>
  <!-- Hero -->
  <section
    class="flex flex-col-reverse items-center gap-10 py-10 md:flex-row md:justify-between"
  >
    <div class="reveal max-w-xl">
      <p class="mb-3 text-sm font-medium uppercase tracking-widest text-accent">
        {c.hero.role}
      </p>
      <h1 class="font-display text-4xl font-bold leading-tight md:text-6xl">
        <span class="text-gradient">{c.hero.name}</span>
      </h1>
      <p class="mt-5 text-lg text-muted">{c.hero.tagline}</p>
      <ul class="mt-5 flex flex-wrap gap-2">
        {c.hero.keywords.map((k) => <li class="chip">{k}</li>)}
      </ul>
      <div class="mt-8 flex flex-wrap gap-3">
        <a href={`${home}#featured`} class="btn btn-primary"
          ><Icon name="lucide:folder-code" class="size-4" />{
            c.hero.cta.projects
          }</a
        >
        <a
          href={c.contact.github}
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
          ><Icon name="mdi:github" class="size-4" />{c.hero.cta.github}</a
        >
        <a href={c.contact.cv} class="btn btn-ghost" download
          ><Icon name="lucide:file-down" class="size-4" />{c.hero.cta.cv}</a
        >
      </div>
    </div>
    <div class="reveal shrink-0">
      <div
        class="rounded-full bg-linear-to-tr from-accent to-accent-2 p-1 shadow-lg shadow-accent/20"
      >
        <div class="rounded-full bg-bg p-1">
          <Image
            src={avatar}
            alt={c.hero.name}
            width={288}
            height={288}
            loading="eager"
            class="size-48 rounded-full object-cover md:size-72"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Focus -->
  <section class="py-12">
    <h2 class="section-title reveal">{c.focus.title}</h2>
    <p class="reveal mb-8 text-muted">{c.focus.intro}</p>
    <div class="grid gap-4 md:grid-cols-2 lg:grid-cols-3">
      {
        c.focus.items.map((item, i) => (
          <article class="card reveal p-5">
            <Icon
              name={item.icon}
              class:list={["size-7", i % 2 ? "text-accent-2" : "text-accent"]}
            />
            <h3 class="mt-3 font-display text-lg font-semibold">{item.name}</h3>
            <p class="mt-2 text-sm text-muted">{item.text}</p>
          </article>
        ))
      }
    </div>
  </section>

  <!-- Featured projects -->
  <section id="featured" class="scroll-mt-20 py-12">
    <h2 class="section-title reveal">{c.featured.title}</h2>
    <div class="reveal">
      <Carousel
        label={c.featured.title}
        autoplay={7000}
        prev={c.ui.prev}
        next={c.ui.next}
      >
        {
          projects.map((p) => {
            const d = p.data[lang];
            return (
              <div class={slide}>
                <article class="card grid overflow-hidden md:grid-cols-[1fr_1.5fr]">
                  <div class="flex min-h-48 items-center justify-center bg-linear-to-br from-accent/25 to-accent-2/25">
                    {p.data.image ? (
                      <img
                        src={p.data.image}
                        alt=""
                        class="size-full object-cover"
                        loading="lazy"
                      />
                    ) : (
                      <Icon name={p.data.icon} class="size-20 text-accent" />
                    )}
                  </div>
                  <div class="p-6 md:p-8">
                    <h3 class="font-display text-xl font-semibold">
                      {d.title}
                    </h3>
                    <p class="mt-2 text-muted">{d.summary}</p>
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {p.data.tech.slice(0, 6).map((id) => (
                        <li>
                          <TechChip id={id} lang={lang} />
                        </li>
                      ))}
                    </ul>
                    <a
                      href={`${localePath(lang, "/projects")}#${p.id}`}
                      class="btn btn-primary mt-6"
                    >
                      {c.featured.open}
                    </a>
                  </div>
                </article>
              </div>
            );
          })
        }
      </Carousel>
    </div>
  </section>

  <!-- About -->
  <section id="about" class="scroll-mt-20 py-12">
    <h2 class="section-title reveal">{c.about.title}</h2>
    <div class="space-y-4">
      {
        c.about.paragraphs.map((p) => (
          <p class="reveal text-justify text-muted">{p}</p>
        ))
      }
    </div>
    <h3 class="reveal mb-3 mt-8 font-display text-lg font-semibold">
      {c.about.softTitle}
    </h3>
    <ul class="reveal flex flex-wrap gap-2">
      {c.about.soft.map((s) => <li class="chip">{s}</li>)}
    </ul>

    <div class="mt-10 grid gap-10 md:grid-cols-2">
      <div>
        <h3 class="reveal mb-4 font-display text-lg font-semibold">
          {c.about.experienceTitle}
        </h3>
        <ol class="space-y-6 border-l border-line pl-5">
          {
            c.about.experience.map((e, i) => (
              <li class="reveal relative">
                <span
                  class:list={[
                    "absolute -left-[1.6rem] top-1.5 size-2.5 rounded-full bg-accent"
                  ]}
                />
                <p class="text-xs text-muted">{e.period}</p>
                <p class="font-medium">{e.role}</p>
                <p class="text-sm text-accent">{e.org}</p>
                <p class="mt-1 text-sm text-muted">{e.text}</p>
              </li>
            ))
          }
        </ol>
      </div>
      <div>
        <h3 class="reveal mb-4 font-display text-lg font-semibold">
          {c.about.educationTitle}
        </h3>
        <ol class="space-y-6 border-l border-line pl-5">
          {
            c.about.education.map((e, i) => (
              <li class="reveal relative">
                <span
                  class:list={[
                    "absolute -left-[1.6rem] top-1.5 size-2.5 rounded-full bg-accent-2",
                  ]}
                />
                <p class="text-xs text-muted">{e.period}</p>
                <p class="font-medium">{e.name}</p>
                <p class="text-sm text-accent">{e.org}</p>
              </li>
            ))
          }
        </ol>
      </div>
    </div>
  </section>

  <!-- Stack -->
  <section id="stack" class="scroll-mt-20 py-12">
    <h2 class="section-title reveal">{c.stack.title}</h2>
    <p class="reveal mb-8 text-muted">{c.stack.intro}</p>
    <div class="space-y-8">
      {
        groups.map((g) => (
          <div class="reveal">
            <h3 class="mb-3 font-display text-base font-semibold">
              {loc(g.name, lang)}
            </h3>
            <ul class="grid grid-cols-3 gap-3 sm:grid-cols-4 md:grid-cols-5 lg:grid-cols-6">
              {g.items.map((item, i) => (
                <li class="card flex flex-col items-center gap-2 p-3 text-center">
                  <Icon
                    name={item.icon}
                    class:list={[
                      "size-7",
                      i % 2 ? "text-accent-2" : "text-accent",
                    ]}
                  />
                  <span class="text-xs">{loc(item.name, lang)}</span>
                </li>
              ))}
            </ul>
          </div>
        ))
      }
    </div>
  </section>

  <!-- Certificates -->
  <section id="certificates" class="scroll-mt-20 py-12">
    <h2 class="section-title reveal">{c.certificates.title}</h2>
    <p class="reveal mb-8 text-muted">{c.certificates.intro}</p>
    <div class="reveal">
      <Carousel
        label={c.certificates.title}
        autoplay={8000}
        prev={c.ui.prev}
        next={c.ui.next}
      >
        {
          certs.map((ct) => {
            const d = ct.data[lang];
            return (
              <div class={slide}>
                <article class="card grid items-center gap-6 p-6 md:grid-cols-[1fr_1.3fr] md:p-8">
                  <img
                    src={ct.data.preview}
                    alt={d.title}
                    loading="lazy"
                    class="max-h-72 w-full rounded-lg border border-line object-contain shadow-lg"
                  />
                  <div>
                    <p class="text-xs text-muted">
                      {ct.data.issuer} · {c.certificates.issued}:{" "}
                      {fmt.format(new Date(ct.data.date))}
                    </p>
                    <h3 class="mt-1 font-display text-xl font-semibold">
                      {d.title}
                    </h3>
                    <p class="mt-3 text-sm text-muted">{d.summary}</p>
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {d.topics.map((t) => (
                        <li class="chip">{t}</li>
                      ))}
                    </ul>
                    <a
                      href={ct.data.file}
                      target="_blank"
                      rel="noopener noreferrer"
                      class="btn btn-ghost mt-6"
                    >
                      <Icon name="lucide:file-text" class="size-4" />
                      {c.certificates.open}
                    </a>
                  </div>
                </article>
              </div>
            );
          })
        }
      </Carousel>
    </div>
  </section>

  <!-- Contact -->
  <section id="contact" class="scroll-mt-20 py-12">
    <h2 class="section-title reveal">{c.contact.title}</h2>
    <ul class="reveal flex flex-wrap gap-3">
      <li>
        <a
          href={c.contact.github}
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
          ><Icon name="mdi:github" class="size-4" />GitHub</a
        >
      </li>
      <li>
        <a
          href={c.contact.linkedin}
          class="btn btn-ghost"
          target="_blank"
          rel="noopener noreferrer"
          ><Icon name="mdi:linkedin" class="size-4" />LinkedIn</a
        >
      </li>
      <li>
        <a href={`mailto:${c.contact.email}`} class="btn btn-ghost"
          ><Icon name="lucide:mail" class="size-4" />{c.contact.email}</a
        >
      </li>
      <li>
        <a href={c.contact.cv} class="btn btn-primary" download
          ><Icon name="lucide:file-down" class="size-4" />{c.hero.cta.cv}</a
        >
      </li>
    </ul>
  </section>
</BaseLayout>
