---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHeader from "../components/PageHeader.astro";
import Metrics from "../components/Metrics.astro";
import TechChip from "../components/TechChip.astro";
import { getContent, localePath, loc, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const c = getContent(lang);
const L = c.projects;
const MAX_TECH = 8;
const allTech = await getCollection("technologies");
const allResearch = await getCollection("research");
const projects = (await getCollection("projects"))
  .filter((p) => p.data.visibility === "public")
  .sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  lang={lang}
  title={L.seoTitle}
  description={L.description}
>
  <PageHeader
    lang={lang}
    title={L.title}
    intro={L.intro}
    kind="projects"
    scope="projects"
  />

  <div class="space-y-8" data-cards>
    {
      projects.map((p) => {
        const d = p.data[lang];
        const url = localePath(lang, `/projects/${p.id}`);
        const relTech = allTech.filter((t) => p.data.concepts.includes(t.id));
        const relRes = allResearch.filter((r) =>
          r.data.projects.includes(p.id),
        );
        const extra = p.data.tech.length - MAX_TECH;
        return (
          <article
            id={p.id}
            data-card
            data-url={url}
            class="card reveal scroll-mt-24 overflow-hidden lg:grid lg:grid-cols-[17rem_minmax(0,1fr)]"
          >
            <div class="flex flex-col items-center justify-center gap-4 bg-linear-to-br from-accent/25 to-accent-2/25 p-8">
              {p.data.image ? (
                <img
                  src={p.data.image}
                  alt=""
                  class="max-h-48 w-full rounded-lg object-cover"
                  loading="lazy"
                />
              ) : (
                <Icon name={p.data.icon} class="size-20 text-accent" />
              )}
              <div class="flex flex-wrap justify-center gap-2">
                <span class="chip border-accent-2/50 text-accent-2">
                  {d.status}
                </span>
                {p.data.year && <span class="chip">{p.data.year}</span>}
              </div>
            </div>

            <div class="flex min-w-0 flex-col p-6 md:p-8">
              <h2 class="font-display text-2xl font-semibold">
                <a href={url} class="transition-colors hover:text-accent-2">
                  {d.title}
                </a>
              </h2>
              {d.subtitle && (
                <p class="mt-1 text-sm text-accent">{d.subtitle}</p>
              )}
              <p class="mt-4 text-muted">{d.summary}</p>

              {d.metrics.length > 0 && (
                <div class="mt-6">
                  <Metrics metrics={d.metrics} />
                </div>
              )}

              <ul class="mt-6 flex flex-wrap gap-2">
                {p.data.tech.slice(0, MAX_TECH).map((id) => (
                  <li>
                    <TechChip id={id} lang={lang} />
                  </li>
                ))}
                {extra > 0 && <li class="chip">+{extra}</li>}
              </ul>

              {(relTech.length > 0 || relRes.length > 0) && (
                <div class="mt-5 flex flex-wrap items-center gap-2 text-xs">
                  <span class="text-muted">{c.projectPage.related}:</span>
                  {relTech.map((t) => (
                    <a
                      class="chip"
                      href={localePath(lang, `/technologies/${t.id}`)}
                    >
                      {t.data[lang].title}
                    </a>
                  ))}
                  {relRes.map((r) => (
                    <a
                      class="chip"
                      href={`${localePath(lang, "/research")}#${r.id}`}
                    >
                      {r.data[lang].title}
                    </a>
                  ))}
                </div>
              )}

              <div class="mt-auto flex flex-wrap gap-3 border-t border-line pt-5 mt-6">
                <a href={url} class="btn btn-primary">
                  {L.details}
                  <Icon name="lucide:arrow-right" class="size-4" />
                </a>
                {p.data.repo && (
                  <a
                    href={p.data.repo}
                    class="btn btn-ghost"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="mdi:github" class="size-4" />
                    {L.repo}
                  </a>
                )}
                {p.data.demo && (
                  <a
                    href={p.data.demo}
                    class="btn btn-ghost"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="lucide:external-link" class="size-4" />
                    {L.demo}
                  </a>
                )}
                {p.data.links.map((l) => (
                  <a
                    href={l.href}
                    class="btn btn-ghost"
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <Icon name="lucide:link" class="size-4" />
                    {loc(l.label, lang)}
                  </a>
                ))}
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
  <p class="mt-4 text-sm text-muted" data-no-results style="display:none">
    {L.noMatch}
  </p>
</BaseLayout>

<script>
  const wrap = document.querySelector<HTMLElement>("[data-cards]");
  if (wrap) {
    const cards = [...wrap.querySelectorAll<HTMLElement>("[data-card]")];
    const empty = document.querySelector<HTMLElement>("[data-no-results]")!;
    window.addEventListener("search:results", (e) => {
      const d = (e as CustomEvent).detail as {
        scope: string;
        query: string;
        urls: string[];
      };
      if (d.scope !== "projects") return;
      const urls = d.query ? new Set(d.urls) : null;
      let shown = 0;
      cards.forEach((card) => {
        const ok = !urls || urls.has(card.dataset.url!);
        card.style.display = ok ? "" : "none";
        if (ok) shown++;
      });
      empty.style.display = shown > 0 ? "none" : "";
    });
  }
</script>
