---
import { getCollection, getEntry } from "astro:content";
import { Icon } from "astro-icon/components";
import BaseLayout from "../layouts/BaseLayout.astro";
import TechChip from "../components/TechChip.astro";
import Metrics from "../components/Metrics.astro";
import { getContent, localePath, loc, type Lang } from "../i18n/utils";

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const c = getContent(lang);
const L = c.projects;
const P = c.projectPage;
const p = (await getEntry("projects", slug))!;
const d = p.data[lang];
const techs = (await getCollection("technologies")).filter((t) =>
  p.data.concepts.includes(t.id),
);
const research = (await getCollection("research")).filter((r) =>
  r.data.projects.includes(slug),
);
const rows = [
  [L.goal, d.goal],
  [L.solution, d.solution],
  [L.result, d.result],
] as const;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "SoftwareSourceCode",
  name: d.title,
  description: d.summary,
  inLanguage: lang,
  ...(p.data.repo && { codeRepository: p.data.repo }),
  programmingLanguage: p.data.tech.filter((id) =>
    ["python", "java", "csharp", "javascript", "typescript", "php"].includes(
      id,
    ),
  ),
  author: { "@type": "Person", name: c.hero.shortName },
};
---

<BaseLayout
  lang={lang}
  title={`${d.title} | ${c.hero.shortName}`}
  description={d.summary}
  jsonLd={jsonLd}
>
  <a href={localePath(lang, "/projects")} class="btn btn-ghost no-print mb-6">
    <Icon name="lucide:arrow-left" class="size-4" />{P.back}
  </a>

  <header class="card reveal relative mb-8 overflow-hidden">
    <div class="bg-linear-to-br from-accent/20 to-accent-2/20 p-6 md:p-10">
      <Icon
        name={p.data.icon}
        aria-hidden="true"
        class="pointer-events-none absolute -bottom-8 -right-8 size-56 text-accent opacity-10"
      />
      <div class="relative">
        <div class="flex flex-wrap items-center gap-2">
          <span class="chip border-accent-2/50 text-accent-2">{d.status}</span>
          {p.data.year && <span class="chip">{p.data.year}</span>}
        </div>
        <h1 class="mt-4 font-display text-3xl font-bold md:text-5xl">
          <span class="text-gradient">{d.title}</span>
        </h1>
        {d.subtitle && <p class="mt-2 text-accent">{d.subtitle}</p>}
        <p class="mt-5 text-muted lg:text-lg">{d.summary}</p>
        <div class="mt-6 flex flex-wrap gap-3">
          {
            p.data.repo && (
              <a
                href={p.data.repo}
                class="btn btn-primary"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="mdi:github" class="size-4" />
                {L.repo}
              </a>
            )
          }
          {
            p.data.demo && (
              <a
                href={p.data.demo}
                class="btn btn-ghost"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="lucide:external-link" class="size-4" />
                {L.demo}
              </a>
            )
          }
          {
            p.data.links.map((l) => (
              <a
                href={l.href}
                class="btn btn-ghost"
                target="_blank"
                rel="noopener noreferrer"
              >
                <Icon name="lucide:link" class="size-4" />
                {loc(l.label, lang)}
              </a>
            ))
          }
        </div>
      </div>
    </div>
  </header>

  {
    d.metrics.length > 0 && (
      <div class="reveal mb-8">
        <Metrics metrics={d.metrics} />
      </div>
    )
  }

  <div
    class="grid gap-8 lg:grid-cols-[minmax(0,1fr)_20rem] xl:grid-cols-[minmax(0,1fr)_22rem]"
  >
    <div class="min-w-0">
      <dl class="card reveal mb-8 divide-y divide-line">
        {
          rows.map(([k, v], i) => (
            <div class="grid gap-2 p-5 md:grid-cols-[9rem_minmax(0,1fr)] md:gap-6">
              <dt
                class:list={[
                  "text-sm font-semibold",
                  i % 2 ? "text-accent-2" : "text-accent",
                ]}
              >
                {k}
              </dt>
              <dd class="text-muted">{v}</dd>
            </div>
          ))
        }
      </dl>

      {
        d.highlights.length > 0 && (
          <ul class="mb-10 grid gap-3 sm:grid-cols-2">
            {d.highlights.map((h) => (
              <li class="card reveal flex gap-3 p-4 text-sm">
                <Icon
                  name="lucide:check"
                  class="mt-0.5 size-4 shrink-0 text-accent-2"
                />
                <span>{h}</span>
              </li>
            ))}
          </ul>
        )
      }

      {
        d.sections.map((s, i) => (
          <section id={`sec-${i + 1}`} class="mb-10 scroll-mt-24">
            <h2 class="section-title reveal text-xl">{s.title}</h2>
            <div class="space-y-3 text-muted">
              {s.body.map((t) => (
                <p class="reveal">{t}</p>
              ))}
            </div>
          </section>
        ))
      }

      {
        techs.length > 0 && (
          <section class="mb-8">
            <h2 class="section-title reveal text-xl">{P.concepts}</h2>
            <ul class="reveal flex flex-wrap gap-3">
              {techs.map((t) => (
                <li>
                  <a
                    class="btn btn-ghost"
                    href={localePath(lang, `/technologies/${t.id}`)}
                  >
                    <Icon name={t.data.icon} class="size-4" />
                    {t.data[lang].title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
      {
        research.length > 0 && (
          <section>
            <h2 class="section-title reveal text-xl">{P.research}</h2>
            <ul class="reveal flex flex-wrap gap-3">
              {research.map((r) => (
                <li>
                  <a
                    class="btn btn-ghost"
                    href={`${localePath(lang, "/research")}#${r.id}`}
                  >
                    {r.data[lang].title}
                  </a>
                </li>
              ))}
            </ul>
          </section>
        )
      }
    </div>

    <aside class="space-y-4 lg:sticky lg:top-24 lg:self-start">
      {
        d.sections.length > 0 && (
          <nav class="card no-print hidden p-5 lg:block" aria-label={P.toc}>
            <h2 class="side-title">{P.toc}</h2>
            <ol class="space-y-2 text-sm">
              {d.sections.map((s, i) => (
                <li>
                  <a href={`#sec-${i + 1}`} class="side-link">
                    {s.title}
                  </a>
                </li>
              ))}
            </ol>
          </nav>
        )
      }
      <section class="card p-5">
        <h2 class="side-title">{P.stack}</h2>
        <ul class="flex flex-wrap gap-2">
          {
            p.data.tech.map((id) => (
              <li>
                <TechChip id={id} lang={lang} />
              </li>
            ))
          }
        </ul>
        {
          p.data.models.length > 0 && (
            <>
              <h3 class="side-title mt-5">{L.models}</h3>
              <ul class="flex flex-wrap gap-2">
                {p.data.models.map((m) => (
                  <li class="chip">{m}</li>
                ))}
              </ul>
            </>
          )
        }
      </section>
    </aside>
  </div>
</BaseLayout>
